rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasGardenAccess() {
      return request.auth != null
        && request.auth.token.gardenAccess == true
        && request.auth.token.secretFaeriesMember == true;
    }

    function isOwner(userId) {
      return hasGardenAccess() && request.auth.uid == userId;
    }

    function isValidPhoto(entryId, userId, fileName) {
      return entryId.size() > 0
        && entryId.size() <= 128
        && userId.size() > 0
        && userId.size() <= 128
        && fileName.size() > 0
        && fileName.size() <= 200
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
        && request.resource.metadata.entryId == entryId
        && request.resource.metadata.userId == userId;
    }

    match /gardenWorkspaces/main/journal/{entryId}/{userId}/{fileName} {
      allow read: if hasGardenAccess();
      allow create: if resource == null
        && isOwner(userId)
        && isValidPhoto(entryId, userId, fileName);
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
