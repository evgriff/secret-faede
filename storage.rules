rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasGardenAccess() {
      return request.auth != null
        && request.auth.token.keys().hasAny(['gardenAccess'])
        && request.auth.token.gardenAccess == true
        && request.auth.token.keys().hasAny(['secretFaeriesMember'])
        && request.auth.token.secretFaeriesMember == true;
    }

    function isOwner(userId) {
      return hasGardenAccess()
        && request.auth.uid == userId;
    }

    match /users/{userId}/journal/{allPaths=**} {
      allow read: if isOwner(userId);

      allow write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /gardenWorkspaces/main/journal/{allPaths=**} {
      allow read: if hasGardenAccess();

      allow write: if hasGardenAccess()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
