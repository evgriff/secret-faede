rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedGardenEmail() {
      return request.auth.token.email in [
        'primary.gardener@example.com',
        'partner.gardener@example.com'
      ];
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && isAllowedGardenEmail();

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && isAllowedGardenEmail();
      }
    }

    match /gardens/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && isAllowedGardenEmail();

      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && isAllowedGardenEmail();
      }
    }

    match /catalog/crops/{cropId} {
      allow read: if request.auth != null && isAllowedGardenEmail();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
